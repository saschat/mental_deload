{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["src/sw.ts", "src/core/**/*.ts", "src/lib/idb.ts", "src/lib/reminderCheck.ts"],
  "exclude": ["src/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo",
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
