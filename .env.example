# App ID from https://cloud.bzr.dev/developers ("test" works with the local mock).
VITE_APP_ID=test
# Bazaar server. Defaults to http://localhost:3377 in dev and the SDK default in production.
# VITE_BAZAAR_URI=https://cloud.bzr.dev
